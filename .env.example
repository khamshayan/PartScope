# PartScope — environment configuration
#
# Copy to `.env` and you are done. Every value below already matches what
# `docker compose up` brings up, so the defaults work with zero edits and
# zero API keys. That is deliberate: the project must run from a clean clone.
#
#   cp .env.example .env      (macOS / Linux)
#   copy .env.example .env    (Windows)

# ---------------------------------------------------------------------------
# PostgreSQL — relational store: price history time series, RFQs, line items
# ---------------------------------------------------------------------------
# Port 5433, not 5432, so this never collides with a Postgres you already run.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=partscope
POSTGRES_USER=partscope
POSTGRES_PASSWORD=partscope

# ---------------------------------------------------------------------------
# MongoDB — document store: the parts catalog (specs differ per category)
# ---------------------------------------------------------------------------
# Port 27018, not 27017, for the same reason.
MONGO_PORT=27018
MONGO_URI=mongodb://localhost:27018
MONGO_DB=partscope

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
# Python FastAPI: matching, pricing, parsing, risk.
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
# Where the Node API reaches the Python service.
ML_SERVICE_URL=http://localhost:8000

# Node/Express API.
API_PORT=3000

# ---------------------------------------------------------------------------
# Dashboard login
# ---------------------------------------------------------------------------
# One username/password pair guarding the whole app. There is no user database
# and no signup: this is the only account.
#
# LEAVE BLANK and the API is open and the dashboard loads straight in, which is
# what keeps a clean clone runnable with no setup. Set BOTH and every endpoint
# except the service banner requires a login; the API logs which state it
# booted in on startup.
AUTH_USER=admin
AUTH_PASSWORD=pass

# Optional. Signs the session cookie. Unset means a new secret each boot, so
# restarting the API signs everyone out. Set it to any long random string to
# keep sessions across restarts.
AUTH_SESSION_SECRET=
# Optional. The session cookie is Secure by default, which browsers accept over
# http://localhost. Set to false only if testing over plain HTTP in a browser
# that refuses it. Never in production. Ignored (forced on) under SameSite=None,
# which browsers reject without it.
AUTH_COOKIE_SECURE=
# Optional: none | lax | strict. Defaults to 'none' when NODE_ENV=production and
# 'lax' otherwise. A frontend on a different domain than this API (Vercel ->
# Render) needs 'none': a 'lax' cookie is never sent on cross-site fetch, so the
# login appears to succeed and every later request is anonymous.
AUTH_COOKIE_SAMESITE=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Which origins may make credentialed (cookie-bearing) cross-origin requests.
# Comma separated. A `*` inside an entry matches ONE label, so a single pattern
# covers every Vercel preview URL without naming them:
#
#   WEB_ORIGIN=https://part-scope-tdjb.vercel.app,https://part-scope-*.vercel.app
#
# LEAVE BLANK for local dev, where the Vite proxy makes everything same-origin
# and there is no cross-origin request to allow.
#
# Blank in production means every origin is reflected back, and combined with
# cookies that lets any site a signed-in user visits call this API as them and
# read the response. Set it once the frontend has a URL.
WEB_ORIGIN=

# Where the React dev server reaches the Node API.
VITE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed controls
# ---------------------------------------------------------------------------
# Fixed seed => the generated catalog and price history are byte-for-byte
# reproducible. Change it only if you want a different synthetic universe.
SEED_RANDOM_SEED=20240815
# Number of parts written to Mongo.
CATALOG_SIZE=8000
# Weeks of weekly price history per part. 104 is the minimum for the SARIMA
# seasonal term (s=52) to have two full cycles to fit against.
PRICE_HISTORY_WEEKS=104

# ---------------------------------------------------------------------------
# Optional: real-data adapters
# ---------------------------------------------------------------------------
# LEAVE BOTH BLANK. The project is designed to run entirely on synthetic data.
# The adapters exist to demonstrate that the architecture accepts a real feed;
# when the key is absent the pipeline logs a notice and uses the generator.
# See docs/data-sources.md.

# Nexar (Octopart). A stub: its methods raise.
NEXAR_API_KEY=

# Mouser Search API. Implemented — `parts()` really fetches a catalog. Get a
# key from mouser.com/api-hub. Note that a live catalog changes day to day, so
# none of the figures quoted in the README are reproducible against it, and
# the adapter has no price history (Mouser publishes current prices only).
MOUSER_API_KEY=
